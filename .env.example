# Скопируйте в .env и заполните два значения. Файл .env не коммитится.
RADIOPUMP_ADMIN_NAME=admin
# Минимум 12 байт; используйте уникальный пароль.
RADIOPUMP_ADMIN_PASSWORD=
# Случайный ключ минимум 32 байта (например, 64 случайных hex-символа).
RADIOPUMP_JWT_SECRET=
RADIOPUMP_BIND=127.0.0.1
RADIOPUMP_PORT=8080
